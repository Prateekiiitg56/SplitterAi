# SplitterAI: one .env for the whole project, at the repo root (copy this file to .env).
# backend/server.py and backend/cli.py load ./.env explicitly, whatever directory they start in.
# The real .env is git-ignored. Provider keys stay on the server; only VITE_ values reach the browser.

# ── Provider keys: at least one is required ─────────────────────────────
# See backend/agentcli/config.py (MODEL_KEYS / PROVIDER_KEYS) for which key each model uses.
# Gemini keys rotate so load spreads over several projects.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_ALT=
# OpenRouter: one account per model group so free quotas do not collide; any one works as a fallback.
OPENROUTER_API_KEY=
OPENROUTER_SUPER_KEY=
OPENROUTER_ULTRA_KEY=
OPENROUTER_KEY_BIG=
OPENROUTER_KEY_REASON=
OPENROUTER_KEY_VISION=
OPENROUTER_KEY_CODE=
OPENROUTER_KEY_FAST=
XAI_GROK_API_KEY=

# ── Per-role keys (optional, tried before the keys above) ────────────────
PLANNER_API_KEY=
CODER_API_KEY=
DESIGNER_API_KEY=
AUDITOR_API_KEY=
TESTER_API_KEY=

# ── Execution limits ────────────────────────────────────────────────────
MAX_STEPS=25
MAX_CONCURRENT_AGENTS=4
MODEL_TIMEOUT=90
STEP_TIMEOUT=180
SHELL_TIMEOUT=30
OUTPUT_MAX_BYTES=10240

# ── Shell sandbox ───────────────────────────────────────────────────────
# auto: run agent shell commands under bubblewrap (Linux) or bubblewrap in WSL (Windows), refuse otherwise.
# none: run them directly on the host (no isolation).
SPLITTER_SANDBOX=auto
SPLITTER_WSL_DISTRO=Ubuntu

# ── Server hardening ────────────────────────────────────────────────────
# SHARED_SECRET: if set, every endpoint except /health needs it (X-API-Key header or ?token=).
SHARED_SECRET=
# Anything but "development" (the Docker image sets "production") requires SHARED_SECRET and ALLOWED_ORIGINS.
SPLITTER_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
# Fernet key for stored integration secrets (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# Empty: a key is generated once into SPLITTER_DATA_DIR/secret.key.
SPLITTER_SECRET_KEY=
# Sessions DB, run history and the generated key; default ~/.agentcli
SPLITTER_DATA_DIR=

# ── Testing ─────────────────────────────────────────────────────────────
# 1 = scripted fake model, no provider calls (end-to-end tests).
SPLITTER_FAKE_LLM=

# ── Supabase (optional): session sync and the Storage integration ───────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=workspace-artifacts

# ── Frontend (VITE_ values are built into the browser bundle) ───────────
# VITE_API_BASE=http://localhost:8000
# Defaults to /ws on VITE_API_BASE (https -> wss).
# VITE_WS_URL=ws://localhost:8000/ws
# Same value as SHARED_SECRET when it is set (or enter it on the Settings page instead).
# VITE_SHARED_SECRET=
