# ── Provider API Keys (server-side only — NOT shipped to the browser) ──
# At least one is required for LLM calls. See backend/agentcli/config.py
# for exactly how each one is resolved (DEFAULT_MODEL_CHAINS / PROVIDER_KEY_ENVVARS).
GEMINI_API_KEY=
GEMINI_API_KEY_ALT=
XAI_GROK_API_KEY=
OPENROUTER_SUPER_KEY=
OPENROUTER_ULTRA_KEY=
OPENROUTER_API_KEY=

# ── Per-Role API Keys (optional — override provider key) ─────
# Set these to use a different account/key per role so parallel agents
# don't share one rate-limit bucket (FR-25). Leave blank to fall back
# to the provider keys resolved by model name.
PLANNER_API_KEY=
CODER_API_KEY=
AUDITOR_API_KEY=
TESTER_API_KEY=

# ── Execution Limits ─────────────────────────────────────────────
MAX_STEPS=25
MAX_CONCURRENT_AGENTS=4
SHELL_TIMEOUT=30
OUTPUT_MAX_BYTES=10240
