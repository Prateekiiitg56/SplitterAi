# ── Provider API Keys (at least one required) ──────────────────
GEMINI_API_KEY=
XAI_GROK_API_KEY=
OPENROUTER_SUPER_KEY=
OPENROUTER_ULTRA_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ── Per-Role API Keys (optional — overrides provider key) ──────
# Set these to use different accounts/keys per role to avoid
# sharing one rate-limit bucket across parallel agents.
PLANNER_API_KEY=
CODER_API_KEY=
AUDITOR_API_KEY=
TESTER_API_KEY=

# ── Execution Limits ───────────────────────────────────────────
MAX_STEPS=25
MAX_CONCURRENT_AGENTS=4
SHELL_TIMEOUT=30
OUTPUT_MAX_BYTES=10240
